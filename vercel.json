{
  "cleanUrls": true,
  "functions": {
    "api/terraform-content.js": {
      "includeFiles": "api/terraform-locked.fragment.html"
    },
    "api/terraform-prototype.js": {
      "includeFiles": "api/terraform-private/policy-set.html"
    },
    "api/terraform-runtime.js": {
      "includeFiles": "api/terraform-private/support.js"
    },
    "api/terraform-scaling.js": {
      "includeFiles": "api/terraform-private/scaling/**"
    },
    "api/terraform-audit.js": {
      "includeFiles": "api/terraform-private/audit-flythrough.mp4"
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/drafts/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/api/terraform-locked.fragment.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/api/_terraformAuth",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/api/_terraformAuth.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/api/terraform-private/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
